# These values are read by deployment scripts. Keep real values out of files and shell history when possible.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace-me
# Feishu open_id returned after the user approves `npm run setup:feishu`.
FEISHU_RECEIVE_ID=replace-with-feishu-open-id
ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Used only by the seeding script after deployment.
WORKER_URL=https://douyin-live-alert-feishu.example.workers.dev
